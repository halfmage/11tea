{
  "name": "11tea",
  "version": "2.0.0",
  "description": "A Eleventy TailwindCSS AplineJS Starter",
  "scripts": {
    "start": "eleventy --serve & npx tailwindcss -i src/styles/tailwind.css -c src/styles/tailwind.config.js -o _site/style.css --watch",
    "build": "eleventy && npx tailwindcss -i src/styles/tailwind.css -c src/styles/tailwind.config.js -o _site/style.css --minify"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/halfmage/11tea.git"
  },
  "author": {
    "name": "Gerrit Halfmann",
    "email": "gerrit@gerrithalfmann.com",
    "url": "https://gerrithalfmann.com/"
  },
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/halfmage/11tea/issues"
  },
  "homepage": "https://github.com/halfmage/11tea#readme",
  "devDependencies": {
    "@11ty/eleventy": "^2.0.1",
    "@11ty/eleventy-server-browsersync": "^1.0.2",
    "alpinejs": "^3.13.10",
    "tailwindcss": "^3.4.3"
  }
}
